---
import PublicPage from '../components/PublicPage.astro';
import ReservationWizard from '../components/reservation/ReservationWizard';
---
<PublicPage title="Reserve a Table — ABCD Restaurant" active="/reserve/"><section class="reserve-head container"><span>Your table awaits</span><h1>Reserve Your Experience</h1><p>Choose your preferred date, time, and dining experience.</p></section><div class="container"><ReservationWizard client:only="react" /></div></PublicPage>
<style is:global>
  .reserve-head{padding:80px 0 45px;text-align:center}.reserve-head>span,.wizard .eyebrow,.confirmation .eyebrow{color:var(--gold);font-size:12px;font-weight:800;letter-spacing:5px;text-transform:uppercase}.reserve-head h1,.confirmation h1{margin:15px 0;color:var(--maroon);font-family:var(--font-serif);font-size:64px}.reserve-head>p{color:var(--muted);font-size:16px}.wizard{padding-bottom:90px}.steps{display:grid;grid-template-columns:repeat(3,1fr);max-width:760px;margin:0 auto 55px;padding:0;list-style:none}.steps li{display:flex;align-items:center;gap:12px;color:#a08e82;font-size:12px;font-weight:700}.steps li:not(:last-child)::after{content:'';height:1px;flex:1;background:#dec8ad}.steps span{display:grid;place-items:center;width:34px;height:34px;border:1px solid #cdb99f;border-radius:50%}.steps .active,.steps .done{color:var(--maroon)}.steps .active span,.steps .done span{border-color:var(--maroon);background:var(--maroon);color:white}.wizard-grid{display:grid;grid-template-columns:minmax(0,1.5fr) 380px;gap:45px;align-items:start}.wizard form,.wizard aside{padding:40px;border:1px solid var(--line);border-radius:18px;background:var(--surface);box-shadow:var(--shadow-card)}.wizard fieldset{display:grid;gap:24px;margin:0;padding:0;border:0}.wizard legend{color:var(--maroon);font-family:var(--font-serif);font-size:36px;font-weight:600}.wizard fieldset>p{margin:0;color:var(--muted)}.wizard label{display:grid;gap:8px;color:var(--maroon);font-size:12px;font-weight:800}.wizard input,.wizard select,.wizard textarea{width:100%;padding:14px;border:1px solid #dbc4a5;border-radius:8px;background:white}.choice-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.choice-grid.times{grid-template-columns:repeat(4,1fr)}.choice-grid button,.wizard .actions>button{padding:14px;border:1px solid #dbc4a5;border-radius:8px;background:white;color:var(--maroon);font-size:12px;font-weight:700}.choice-grid button.selected{border-color:var(--maroon);background:var(--maroon);color:white}.wizard button{cursor:pointer}.wizard .next{justify-self:end;padding:14px 24px;border:0;border-radius:30px;background:var(--maroon);color:white;font-size:12px;font-weight:800}.wizard .next:disabled{opacity:.45;cursor:not-allowed}.actions{display:flex;justify-content:space-between}.wizard aside h2{color:var(--maroon);font-family:var(--font-serif);font-size:31px}.wizard dl{display:grid;gap:0;margin:25px 0}.wizard dl div{display:flex;justify-content:space-between;padding:15px 0;border-bottom:1px solid #ead8bf}.wizard dt{color:var(--muted);font-size:12px}.wizard dd{margin:0;color:var(--maroon);font-size:12px;font-weight:800}.wizard aside>p:last-child{color:var(--muted);font-size:12px;line-height:1.6}.status{min-height:20px;color:#a22b38!important;font-size:12px}.confirmation{max-width:760px;margin:0 auto 100px;padding:65px;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:var(--shadow-soft);text-align:center}.confirmation .check{display:grid;place-items:center;width:70px;height:70px;margin:0 auto 25px;border-radius:50%;background:var(--maroon);color:white;font-size:34px}.confirmation>p{color:var(--muted)}.confirmation button{padding:14px 24px;border:0;border-radius:30px;background:var(--maroon);color:white;font-weight:800}@media(max-width:850px){.wizard-grid{grid-template-columns:1fr}.choice-grid.times{grid-template-columns:repeat(2,1fr)}}
</style>
<style is:global>.confirmation h2{margin:15px 0;color:var(--maroon);font-family:var(--font-serif);font-size:64px}</style>
