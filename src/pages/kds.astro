---
import BaseLayout from '../layouts/BaseLayout.astro';
const orders=[['#1042','dine','Table 12',['Butter Chicken','Garlic Naan','Mango Lassi'],'12 min'],['#1043','pickup','Alex',['Lucknowi Biryani','Dal Makhani'],'8 min'],['#1044','delivery','DoorDash',['Paneer Achari Tikka','Veg Manchurian','Kulfi'],'5 min'],['#1045','dine','Table 7',['Tandoori Chicken','Laccha Paratha'],'3 min'],['#1046','pickup','Sam',['Malabar Prawn Curry','Garlic Naan'],'1 min']];
---
<BaseLayout title="Kitchen Display — ABCD Restaurant" noIndex><header class="kds-head"><img src="/assets/logo.png" alt="ABCD Restaurant" /><div><h1>Kitchen Display</h1><p>Sunday, July 6 · Dinner service</p></div><time>7:42 PM</time></header><main class="kds"><nav aria-label="Order type filters"><button class="active" data-filter="all">All Orders</button><button data-filter="dine">Dine In</button><button data-filter="pickup">Pickup</button><button data-filter="delivery">Delivery</button></nav><section class="orders" aria-live="polite">{orders.map(([id,type,customer,items,time])=><article data-order-type={type}><header><div><span>{type}</span><h2>{id}</h2></div><strong>{time}</strong></header><h3>{customer}</h3><ol>{(items as string[]).map(item=><li>{item}</li>)}</ol><footer><button>Start</button><button>Ready</button></footer></article>)}</section><p class="filter-status sr-only" role="status"></p></main></BaseLayout>
<script>const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];const cards=[...document.querySelectorAll<HTMLElement>('[data-order-type]')];buttons.forEach(button=>button.addEventListener('click',()=>{const filter=button.dataset.filter;buttons.forEach(item=>item.classList.toggle('active',item===button));let visible=0;cards.forEach(card=>{const show=filter==='all'||card.dataset.orderType===filter;card.hidden=!show;if(show)visible++});document.querySelector<HTMLElement>('.filter-status')!.textContent=`Showing ${visible} ${filter} orders`}));</script>
<style>.kds-head{display:grid;grid-template-columns:180px 1fr auto;align-items:center;padding:24px 45px;background:var(--maroon);color:white}.kds-head img{width:120px;filter:brightness(0) invert(1)}.kds-head h1{margin:0;font-family:var(--font-serif);font-size:30px}.kds-head p{margin:3px 0;font-size:11px;opacity:.8}.kds-head time{font-size:24px;font-weight:800}.kds{padding:35px 45px;background:#f2ede5;min-height:calc(100vh - 105px)}nav{display:flex;gap:10px;margin-bottom:30px}nav button{padding:12px 22px;border:1px solid #cbb8a1;border-radius:30px;background:white;color:var(--maroon);font-size:12px;font-weight:800}nav button.active{background:var(--maroon);color:white}.orders{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}.orders article{overflow:hidden;border-radius:12px;background:white;box-shadow:0 8px 20px rgb(0 0 0 / 7%)}.orders article>header{display:flex;justify-content:space-between;padding:18px;background:#f7ead9}.orders article>header span{color:var(--gold);font-size:9px;font-weight:800;text-transform:uppercase}.orders h2{margin:3px 0;color:var(--maroon);font-size:24px}.orders article>header strong{color:var(--maroon);font-size:12px}.orders h3{margin:18px;padding-bottom:12px;border-bottom:1px solid #eee0cf;color:var(--ink)}.orders ol{min-height:155px;margin:0;padding:0 35px;color:var(--ink);font-size:13px;line-height:2}.orders footer{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:15px}.orders footer button{padding:11px;border:1px solid var(--maroon);border-radius:7px;background:white;color:var(--maroon);font-weight:800}.orders footer button:last-child{background:var(--maroon);color:white}@media(max-width:1100px){.orders{grid-template-columns:repeat(2,1fr)}}</style>
<style>@media(max-width:700px){.kds-head{grid-template-columns:1fr auto;padding:18px}.kds-head img{display:none}.kds-head h1{font-size:24px}.kds-head time{font-size:16px}.kds{padding:24px 18px}.kds nav{overflow-x:auto}.kds nav button{flex:0 0 auto}.orders{grid-template-columns:minmax(0,1fr)}}</style>
