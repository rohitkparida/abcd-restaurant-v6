---
import OrderLayout from '../../../components/OrderLayout.astro';
---
<OrderLayout title="Processing Payment" step={2}><section class="processing"><div class="spinner" aria-hidden="true"></div><span>Secure payment</span><h1>Processing your order…</h1><p role="status" aria-live="polite">Please keep this page open while we confirm your payment.</p><a href="/order/payment/" hidden data-recovery>Return to payment</a></section></OrderLayout>
<script>const status=document.querySelector<HTMLElement>('[role=status]');const recovery=document.querySelector<HTMLElement>('[data-recovery]');setTimeout(()=>{if(status)status.textContent='This is taking longer than expected. You can safely return to payment and try again.';if(recovery)recovery.hidden=false},10000);setTimeout(()=>{location.href='/order/success/?screen=delivery'},1800);</script>
<style>.processing{display:grid;justify-items:center;max-width:650px;margin:120px auto;padding:65px;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:var(--shadow-soft);text-align:center}.spinner{width:74px;height:74px;margin-bottom:30px;border:7px solid #ead8bf;border-top-color:var(--maroon);border-radius:50%;animation:spin 1s linear infinite}.processing span{color:var(--gold);font-size:11px;letter-spacing:4px;text-transform:uppercase}h1{margin:15px;color:var(--maroon);font-family:var(--font-serif);font-size:44px}p{color:var(--muted);line-height:1.6}a{padding:13px 20px;border-radius:30px;background:var(--maroon);color:white;font-size:12px;font-weight:800}@keyframes spin{to{transform:rotate(360deg)}}</style>
