---
import OrderLayout from '../../../components/OrderLayout.astro';import OrderSummary from '../../../components/OrderSummary.astro';
---
<OrderLayout title="Checkout" step={1}><section class="checkout-page order-container"><form id="checkout-form" novalidate><span>Checkout details</span><h1>How should we prepare your order?</h1><fieldset><legend>Fulfillment</legend><div class="toggle"><label><input type="radio" name="fulfillment" value="pickup" checked />Pickup</label><label><input type="radio" name="fulfillment" value="delivery" />Delivery</label></div></fieldset><div class="two"><label>Full name<input required autocomplete="name" placeholder="Enter your full name" /></label><label>Mobile number<input required autocomplete="tel" placeholder="Enter your mobile number" /></label></div><label>Email address<input required type="email" autocomplete="email" placeholder="Enter your email address" /></label><div data-address hidden><label>Delivery address<input required disabled autocomplete="street-address" placeholder="Enter your delivery address" /></label></div><label>Order notes<textarea rows="4" placeholder="Dietary or preparation requests"></textarea></label><p role="alert" class="error"></p><button type="submit">Continue to Payment →</button></form><OrderSummary compact /></section></OrderLayout>
<script>const form=document.querySelector<HTMLFormElement>('#checkout-form');const address=document.querySelector<HTMLElement>('[data-address]');document.querySelectorAll<HTMLInputElement>('[name=fulfillment]').forEach(r=>r.addEventListener('change',()=>{const delivery=r.value==='delivery'&&r.checked;if(address){address.hidden=!delivery;const input=address.querySelector<HTMLInputElement>('input');if(input)input.disabled=!delivery}}));form?.addEventListener('submit',event=>{event.preventDefault();const first=form.querySelector<HTMLElement>(':invalid');if(first){const error=form.querySelector<HTMLElement>('.error');if(error)error.textContent='Please complete the required fields.';first.focus();return}location.href='/order/payment/'});</script>
<style>.order-container{width:min(calc(100% - 80px),1100px);margin:auto}.checkout-page{display:grid;grid-template-columns:1fr 390px;gap:55px;align-items:start;padding:70px 0}form{display:grid;gap:22px;padding:38px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}form>span{color:var(--gold);font-size:11px;letter-spacing:4px;text-transform:uppercase}h1{margin:0 0 15px;color:var(--maroon);font-family:var(--font-serif);font-size:38px;line-height:1.1}fieldset{padding:0;border:0}legend,label{color:var(--maroon);font-size:11px;font-weight:800}.toggle{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px}.toggle label{padding:13px;border:1px solid var(--line);border-radius:8px}.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}form>label,.two label,[data-address] label{display:grid;gap:8px}input,textarea{width:100%;padding:13px;border:1px solid #dbc4a5;border-radius:8px;background:white}form>button{justify-self:end;padding:14px 23px;border:0;border-radius:30px;background:var(--maroon);color:white;font-size:12px;font-weight:800}.error{min-height:18px;margin:0;color:#a22b38;font-size:11px}</style>
<style>@media(max-width:700px){.order-container{width:calc(100% - 36px)}.checkout-page{grid-template-columns:minmax(0,1fr);gap:32px;padding:42px 0}form{padding:24px 18px}.two{grid-template-columns:1fr}}</style>
