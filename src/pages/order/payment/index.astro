---
import OrderLayout from '../../../components/OrderLayout.astro';import OrderSummary from '../../../components/OrderSummary.astro';
---
<OrderLayout title="Payment" step={2}><section class="payment-page order-container"><form id="payment-form"><span>Secure payment</span><h1>Choose a payment method</h1><label class="option"><input type="radio" name="method" checked />Credit or debit card</label><div class="card-fields"><label>Card number<input inputmode="numeric" required placeholder="0000 0000 0000 0000" /></label><div><label>Expiry<input required placeholder="MM / YY" /></label><label>CVV<input required inputmode="numeric" placeholder="123" /></label></div><label>Name on card<input required autocomplete="cc-name" placeholder="Enter name on card" /></label></div><label class="option"><input type="radio" name="method" />Pay at restaurant</label><button>Pay $83.25 →</button></form><OrderSummary compact /></section></OrderLayout>
<script>const paymentForm=document.querySelector<HTMLFormElement>('#payment-form');paymentForm?.addEventListener('submit',event=>{event.preventDefault();const first=paymentForm.querySelector<HTMLElement>(':invalid');if(first){first.focus();return}location.href='/order/processing/'});</script>
<style>.order-container{width:min(calc(100% - 80px),1100px);margin:auto}.payment-page{display:grid;grid-template-columns:1fr 390px;gap:55px;align-items:start;padding:70px 0}form{display:grid;gap:18px;padding:38px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}form>span{color:var(--gold);font-size:11px;letter-spacing:4px;text-transform:uppercase}h1{margin:0 0 12px;color:var(--maroon);font-family:var(--font-serif);font-size:40px}.option{padding:16px;border:1px solid var(--line);border-radius:9px;color:var(--maroon);font-size:12px;font-weight:800}.card-fields{display:grid;gap:16px;padding:20px;border-radius:10px;background:#f7eddf}.card-fields>label,.card-fields>div label{display:grid;gap:7px;color:var(--maroon);font-size:10px;font-weight:800}.card-fields>div{display:grid;grid-template-columns:1fr 1fr;gap:14px}input{padding:12px;border:1px solid #dbc4a5;border-radius:7px}form>button{justify-self:end;padding:14px 25px;border:0;border-radius:30px;background:var(--maroon);color:white;font-size:12px;font-weight:800}@media(max-width:700px){.order-container{width:calc(100% - 36px)}.payment-page{grid-template-columns:minmax(0,1fr);gap:32px;padding:42px 0}form{min-width:0;padding:24px 18px}h1{font-size:34px}.card-fields{min-width:0;padding:16px}.card-fields>div{grid-template-columns:1fr}.card-fields input{min-width:0;width:100%}}</style>
