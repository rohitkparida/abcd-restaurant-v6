---
import OrderLayout from '../../../components/OrderLayout.astro';
---
<OrderLayout title="Order Confirmed" step={3}><section class="success" data-success><span class="check">✓</span><p class="eyebrow" data-kicker>Order confirmed</p><h1 data-title>Your order is being prepared.</h1><p data-copy>Thank you for choosing ABCD Restaurant.</p><div class="detail"><span>Confirmation</span><strong>ABCD-246810</strong></div><div class="actions"><a href="/menu/">Order More</a><a href="/">Return Home</a></div></section></OrderLayout>
<script>const states={dinein:{kicker:'Dine-in order confirmed',title:'Your table order is in.',copy:'We’ll bring your dishes to the table as soon as they are ready.'},delivery:{kicker:'Order confirmed',title:'Your order is being prepared.',copy:'We’ll notify you when your order is ready for delivery or pickup.'},reservation:{kicker:'Reservation confirmed',title:'Your table is waiting.',copy:'We look forward to welcoming you to ABCD Restaurant.'}} as const;const key=new URLSearchParams(location.search).get('screen');const state=states[key as keyof typeof states]??states.dinein;document.querySelector<HTMLElement>('[data-kicker]')!.textContent=state.kicker;document.querySelector<HTMLElement>('[data-title]')!.textContent=state.title;document.querySelector<HTMLElement>('[data-copy]')!.textContent=state.copy;</script>
<style>.success{display:grid;justify-items:center;max-width:720px;margin:90px auto;padding:65px;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:var(--shadow-soft);text-align:center}.check{display:grid;place-items:center;width:76px;height:76px;border-radius:50%;background:var(--maroon);color:white;font-size:38px}.eyebrow{margin-top:25px;color:var(--gold);font-size:11px;font-weight:800;letter-spacing:4px;text-transform:uppercase}h1{margin:12px;color:var(--maroon);font-family:var(--font-serif);font-size:48px}p{color:var(--muted);line-height:1.6}.detail{display:flex;justify-content:space-between;width:100%;margin-top:25px;padding:18px;border-block:1px solid #e8d8c4;color:var(--muted);font-size:12px}.detail strong{color:var(--maroon)}.actions{display:flex;gap:14px;margin-top:30px}.actions a{padding:13px 20px;border:1px solid var(--maroon);border-radius:30px;color:var(--maroon);font-size:12px;font-weight:800}.actions a:first-child{background:var(--maroon);color:white}</style>
