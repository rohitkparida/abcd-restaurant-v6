---
import PublicPage from '../../components/PublicPage.astro';
---
<PublicPage title="Contact — ABCD Restaurant" active="/contact/"><section class="contact-hero container"><div><span>We’d love to hear from you</span><h1>Contact Us</h1><p>Questions, celebrations, catering, or simply a hello—our team is here to help.</p><div class="details"><article><h2>Visit Us</h2><p>417 Lancaster Ave,<br />Malvern, Pennsylvania 19355</p></article><article><h2>Call Us</h2><p>(484) 555-0193</p></article><article><h2>Hours</h2><p>Mon–Fri 11am–10pm<br />Sat–Sun 11am–11pm</p></article></div></div><form id="contact-form" novalidate><label>Full name<input name="name" autocomplete="name" required placeholder="Enter your full name" /></label><label>Email address<input name="email" type="email" autocomplete="email" required placeholder="Enter your email address" /></label><label>Phone number<input name="phone" type="tel" autocomplete="tel" placeholder="Enter your mobile number" /></label><label>Message<textarea name="message" rows="6" required placeholder="How can we help?"></textarea></label><button type="submit">Send Message →</button><p class="status" role="status" aria-live="polite"></p></form></section></PublicPage>
<script>const form=document.querySelector<HTMLFormElement>('#contact-form');form?.addEventListener('submit',event=>{event.preventDefault();const invalid=form.querySelector<HTMLElement>(':invalid');if(invalid){invalid.focus();return}const status=form.querySelector<HTMLElement>('.status');if(status)status.textContent='Thank you. Your message has been received.';form.reset()});</script>
<style>.contact-hero{display:grid;grid-template-columns:1fr 1fr;gap:100px;padding-block:110px}.contact-hero>div>span{color:var(--gold);font-size:12px;letter-spacing:5px;text-transform:uppercase}.contact-hero h1{margin:18px 0;color:var(--maroon);font-family:var(--font-serif);font-size:82px}.contact-hero>div>p{max-width:520px;color:var(--muted);font-size:19px;line-height:1.55}.details{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:60px}.details article{padding:22px;border:1px solid var(--line);border-radius:12px}.details h2{color:var(--maroon);font-family:var(--font-serif);font-size:19px}.details p{color:var(--muted);font-size:12px;line-height:1.5}form{display:grid;gap:22px;padding:45px;border:1px solid var(--line);border-radius:18px;background:var(--surface);box-shadow:var(--shadow-soft)}label{display:grid;gap:8px;color:var(--maroon);font-size:12px;font-weight:800}input,textarea{width:100%;padding:14px 16px;border:1px solid #ddc8ac;border-radius:8px;background:white;color:var(--ink);font-weight:400}button{justify-self:start;padding:14px 25px;border:0;border-radius:30px;background:var(--maroon);color:white;font-size:12px;font-weight:800}.status{min-height:20px;margin:0;color:var(--maroon);font-size:12px}@media(max-width:900px){.contact-hero{grid-template-columns:1fr}.details{grid-template-columns:1fr}}</style>
