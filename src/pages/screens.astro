---
import BaseLayout from '../layouts/BaseLayout.astro';
const groups=[['Public',['/','/menu/','/our-story/','/gallery/','/contact/','/reserve/']],['Ordering',['/order/cart/','/order/checkout/','/order/payment/','/order/processing/','/order/success/?screen=dinein','/order/payment-exception/?state=failed']],['Operations',['/kds/','/exceptions/invalid-link/','/exceptions/closed/','/exceptions/table-ordering-paused/']],['Menu Variants',['/menu/variants/1/','/menu/variants/2/','/menu/variants/3/','/menu/variants/4/','/menu/variants/5/']]];
---
<BaseLayout title="V6 Screen Inventory" noIndex><main class="screens container"><span>ABCD Restaurant V6</span><h1>Screen Inventory</h1><p>Ground-up flow-based implementation routes.</p>{groups.map(([title,routes])=><section><h2>{title}</h2><div>{(routes as string[]).map(route=><a href={route}><strong>{route}</strong><span>Open →</span></a>)}</div></section>)}</main></BaseLayout>
<style>.screens{padding:70px 0}.screens>span{color:var(--gold);font-size:11px;letter-spacing:4px;text-transform:uppercase}.screens>h1{margin:15px 0;color:var(--maroon);font-family:var(--font-serif);font-size:60px}.screens>p{color:var(--muted)}section{margin-top:45px}section h2{color:var(--maroon);font-family:var(--font-serif);font-size:28px}section>div{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}a{display:flex;justify-content:space-between;padding:18px;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--maroon);font-size:12px}@media(max-width:700px){.screens{padding:45px 0}.screens>h1{font-size:42px}section>div{grid-template-columns:minmax(0,1fr)}a{min-width:0;gap:12px}a strong{min-width:0;overflow-wrap:anywhere}a span{flex:0 0 auto}}</style>
