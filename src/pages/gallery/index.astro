---
import PublicPage from '../../components/PublicPage.astro';
import { assetPath } from '../../lib/site';
const tiles=[
  ['ambience-main.png','Dining Room','A warm, welcoming room for everyday meals and special nights.'],
  ['gallery-1.png','Evening Lights','Soft light, bold color, and a table ready for conversation.'],
  ['gallery-2.png','Service Bar','Fresh drinks, quick welcomes, and friendly service.'],
  ['gallery-3.png','Private Lounge','Comfortable seating for groups, celebrations, and family gatherings.'],
  ['gallery-4.png','Gathering Tables','Classic hospitality with a modern cultural edge.'],
];
const moments=[
  ['menu-hero-food.png','Signature Plates','Layered biryanis, soulful curries, and freshly prepared breads.'],
  ['gallery-2.png','Bright Corners','Casual moments for lunch, dinner, and quick gatherings.'],
  ['interior.png','Warm Ambience','Soft light and intimate seating shaped for hospitality.'],
  ['menu/lucknowi-biryani.png','Chef’s Picks','Comforting dishes crafted with heart, spice, and memory.'],
];
---
<PublicPage title="Gallery — ABCD Restaurant" active="/gallery/">
    <section class="gallery-hero container">
      <div class="hero-copy"><span>ABCD in moments</span><h1>A glimpse of<br><em>our table.</em></h1><p>From intimate dinners to bright celebrations, explore the spaces, dishes, and details that bring ABCD to life.</p></div>
      <div class="hero-collage"><img class="hero-main" src={assetPath('interior.png')} alt="ABCD dining room" /><img class="hero-small" src={assetPath('gallery-1.png')} alt="Colorful lounge" /><figure><img src={assetPath('gallery-3.png')} alt="Private seating" /></figure></div>
    </section>
    <section class="gallery-content container">
      <header class="section-head"><span>Our Gallery</span><h2>Scenes filled with<br><em>warmth & spice.</em></h2></header>
      <div class="tile-grid">{tiles.map(([image,title,copy],index)=><article class:list={{large:index===0}}><img src={assetPath(image)} alt={title} /><div><h3>{title}</h3><p>{copy}</p></div></article>)}</div>
      <section class="visit"><img src={assetPath('exterior.png')} alt="ABCD Restaurant exterior" /><div><span>Visit Malvern</span><h2>A place to arrive,<br><em>linger, and return.</em></h2><p>Every detail, from the plated biryani to the glow of the dining room, is designed to make the meal feel memorable. Browse the gallery, then reserve your table.</p><a href="/reserve/">Book Your Table <b>→</b></a></div></section>
      <section class="moments">{moments.map(([image,title,copy])=><article><img src={assetPath(image)} alt={title} /><h3>{title}</h3><p>{copy}</p></article>)}</section>
    </section>
    <section class="gallery-cta container"><h2>Ready to experience<br><em>ABCD in person?</em></h2><div><a href="/reserve/">Reserve a Table</a><a href="/menu/">View Our Menu →</a></div></section>
</PublicPage>
<style>
  .gallery-hero{display:grid;grid-template-columns:520px 1fr;align-items:center;min-height:620px}.hero-copy{padding-left:35px}.hero-copy>span,.section-head>span,.visit span{color:var(--gold);font-size:11px;font-weight:800;letter-spacing:4px;text-transform:uppercase}.hero-copy h1{margin:15px 0 35px;color:var(--maroon);font-family:var(--font-serif);font-size:68px;line-height:.98}.hero-copy h1 em,.section-head h2 em,.visit h2 em,.gallery-cta em{display:block;color:var(--gold);font-weight:500}.hero-copy p{max-width:420px;color:var(--muted);font-size:17px;font-weight:600;line-height:1.6}.hero-collage{position:relative;min-height:480px}.hero-main{position:absolute;right:0;top:25px;width:560px;height:350px;object-fit:cover}.hero-small{position:absolute;left:80px;bottom:0;z-index:2;width:268px;height:190px;border-radius:16px;object-fit:cover;box-shadow:var(--shadow-soft)}.hero-collage figure{position:absolute;right:55px;bottom:5px;z-index:3;width:196px;height:146px;margin:0;padding:10px 10px 28px;background:#fff9ee;border:1px solid var(--line);box-shadow:var(--shadow-card);transform:rotate(3deg)}.hero-collage figure img{width:100%;height:100%;object-fit:cover}.gallery-content{padding-top:60px;border-top:1px solid #eee0d0}.section-head{text-align:center}.section-head h2,.visit h2{margin:12px 0 45px;color:var(--maroon);font-family:var(--font-serif);font-size:48px;line-height:1}.tile-grid{display:grid;grid-template-columns:1.16fr .84fr .84fr;grid-template-rows:260px 260px;gap:24px}.tile-grid article{position:relative;overflow:hidden;border:1px solid var(--line);border-radius:18px;background:var(--surface);box-shadow:var(--shadow-card)}.tile-grid article.large{grid-row:span 2}.tile-grid article>img{width:100%;height:100%;object-fit:cover}.tile-grid article>div{position:absolute;right:22px;bottom:18px;left:22px;padding:14px 18px;border:1px solid rgb(232 205 166 / 80%);border-radius:14px;background:rgb(255 251 244 / 86%);backdrop-filter:blur(8px)}.tile-grid h3{margin:0;color:var(--maroon);font-family:var(--font-serif);font-size:23px}.tile-grid p{margin:5px 0 0;color:var(--muted);font-size:11px;line-height:1.35}.visit{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:72px;margin-top:82px}.visit>img{width:100%;height:390px;border-radius:18px;object-fit:cover;box-shadow:var(--shadow-soft)}.visit h2{margin-bottom:25px}.visit p{max-width:500px;color:var(--muted);font-size:17px;line-height:1.7}.visit a{display:inline-flex;align-items:center;gap:20px;margin-top:15px;padding:8px 9px 8px 22px;border-radius:30px;background:var(--maroon);color:white;font-size:12px;font-weight:800}.visit a b{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:white;color:var(--maroon)}.moments{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-top:88px}.moments article{min-height:318px;padding:18px;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:var(--shadow-card)}.moments img{width:100%;height:210px;border-radius:14px;object-fit:cover}.moments h3{margin:18px 0 8px;color:var(--maroon);font-family:var(--font-serif);font-size:24px;font-weight:500}.moments p{margin:0;color:var(--muted);font-size:12px;line-height:1.45}.gallery-cta{display:flex;align-items:center;justify-content:space-between;min-height:202px;margin-top:88px;margin-bottom:95px;padding:45px 74px;overflow:hidden;border-radius:18px;background:var(--maroon);color:white;box-shadow:var(--shadow-soft)}.gallery-cta h2{margin:0;font-family:var(--font-serif);font-size:42px;font-weight:500}.gallery-cta>div{display:flex;align-items:center;gap:18px}.gallery-cta a{padding:17px 28px;border-radius:30px;color:white;font-size:12px;font-weight:800}.gallery-cta a:first-child{background:#c79a57}
  @media(max-width:800px){.gallery-hero{grid-template-columns:1fr;min-height:auto;padding-top:55px}.hero-copy{padding-left:0}.hero-copy h1{font-size:52px}.hero-collage{min-height:390px}.hero-main{width:92%;height:300px}.hero-small{left:0;width:48%;height:150px}.hero-collage figure{right:10px;width:42%;height:130px}.tile-grid{grid-template-columns:1fr;grid-template-rows:none}.tile-grid article,.tile-grid article.large{height:300px;grid-row:auto}.visit{grid-template-columns:1fr;gap:35px}.visit>img{height:280px}.moments{grid-template-columns:1fr 1fr;gap:14px}.moments article{min-height:0;padding:12px}.moments img{height:130px}.gallery-cta{display:block;padding:38px 25px}.gallery-cta>div{flex-wrap:wrap;margin-top:25px}}
</style>
