---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PromiseCard from '../components/PromiseCard.astro';
const categories = [
  ['cat-app.png','Appetizers'], ['cat-biryani.png','Biryani & Bread'], ['cat-curry.png','Curries'],
  ['cat-indo.png','Indo-Chinese'], ['cat-dragon.png','Dragon & Spice'], ['cat-dessert.png','Desserts'], ['cat-drink.png','Drinks'],
];
const dishes = [
  ['signature-biryani.png','Lucknowi Murgh Biryani','A royal classic layered with aromatic basmati and tender chicken.','$18.59'],
  ['signature-curry.png','Malabar Prawn Curry','A rich coastal curry simmered with coconut and warm spices.','$22.99'],
  ['signature-dal.png','Dal Makhani','Black lentils slow cooked overnight with butter and cream.','$16.09'],
];
const gallery = ['/assets/gallery-1.png','/assets/gallery-2.png','/assets/gallery-3.png','/assets/gallery-4.png'];
---
<BaseLayout title="ABCD Restaurant — Home">
  <SiteHeader active="/" />
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <h1>Rooted in<br />Tradition.<em>Redefined<br />for Today.</em></h1>
          <p>From aromatic biryanis to soulful curries, every dish is a celebration of India’s rich heritage and global flavours.</p>
          <a class="pill-button" href="/menu/">Explore Our Menu <span>→</span></a>
        </div>
        <div class="hero-art">
          <img src="/assets/home/hero-biryani-clean-v2.png" alt="Biryani served in a copper bowl" />
          <div class="promise-position"><PromiseCard /></div>
        </div>
      </div>
    </section>

    <section class="menu-explorer container" aria-labelledby="explore-title">
      <h2 id="explore-title"><span>Explore Our Menu</span></h2>
      <div class="category-grid">{categories.map(([image,label]) => <a href="/menu/"><img src={`/assets/home/${image}`} alt="" /><strong>{label}</strong></a>)}</div>
      <a class="text-link" href="/menu/">View Full Menu →</a>
    </section>

    <section class="signature container">
      <div class="section-copy"><span class="eyebrow">✦ Signature dishes</span><h2>Crafted with<em>Heart &amp; Spice</em></h2><p>A curated selection of our most-loved dishes, bringing together tradition, flavour and passion.</p><a href="/menu/">View All Dishes →</a></div>
      <div class="dish-grid">{dishes.map(([image,name,description,price], index) => <article class="dish-card"><div class="dish-image"><img src={`/assets/home/${image}`} alt={name} />{index === 0 && <span>Chef’s Pick</span>}</div><div class="dish-body"><h3>{name}</h3><p>{description}</p><strong>{price}</strong></div></article>)}</div>
    </section>

    <section class="experience container">
      <img class="ambience" src="/assets/ambience-main.png" alt="ABCD Restaurant dining room" />
      <div><span class="eyebrow">Warm · welcoming · memorable</span><h2>More than a meal,<em>it’s an experience.</em></h2><p>Intimate spaces, warm hospitality and a setting that stays with you.</p><a class="pill-button" href="/reserve/">Book Your Table <span>→</span></a></div>
    </section>
    <section class="gallery-row container" aria-label="Restaurant gallery">{gallery.map((image, index) => <figure><img src={image} alt={`ABCD Restaurant interior ${index + 1}`} /><figcaption>Evenings done right.</figcaption></figure>)}</section>

    <section class="delivery"><div class="container"><div class="delivery-frame"><h2>Our Delivery Partners</h2><p>Order from your favorite delivery platforms</p><div class="partner-grid"><a href="https://www.grubhub.com"><strong>GRUBHUB</strong><span>Order on Grubhub</span></a><a href="https://www.doordash.com"><strong>➥ DOORDASH</strong><span>Order on DoorDash</span></a><a href="https://www.seamless.com"><strong>seamless</strong><span>Order on Seamless</span></a></div></div></div></section>

    <section class="why container"><svg class="why-leaf" viewBox="0 0 100 130" aria-hidden="true"><path d="M15 128C24 72 45 35 77 5M30 80C8 72 4 50 4 50c24 1 32 17 26 30M44 58c-20-11-18-31-18-31 22 7 26 22 18 31M60 39c-13-18-5-34-5-34 15 12 15 25 5 34M28 104c-19 1-27-16-27-16 22-5 31 5 27 16M49 94c-12-15-3-31-3-31 16 13 15 25 3 31M65 69c-12-12-6-26-6-26 14 9 17 20 6 26" /></svg><h2>Why Dine With Us</h2><div class="why-grid">{[['why-fresh.png','Fresh Ingredients','Sourced daily from local farms & markets.'],['why-recipes.png','Authentic Recipes','True to tradition, crafted with care.'],['why-love.png','Made with Love','Every dish includes our passion.'],['why-hosp.png','Warm Hospitality','Because you’re not just a guest, you’re family.']].map(([image,title,copy]) => <article><img src={`/assets/home/${image}`} alt="" /><h3>{title}</h3><p>{copy}</p></article>)}</div></section>

    <section class="final-cta container"><svg class="cta-lines" viewBox="0 0 400 180" aria-hidden="true"><path d="M18 170C38 103 83 62 142 16M34 127c-29-7-32-35-32-35 31 5 43 20 32 35m28-32C36 79 43 52 43 52c28 10 32 29 19 43m36-31C78 43 92 20 92 20c20 20 18 37 6 44M285 176V85c0-43 24-67 52-67s52 24 52 67v91M285 105h104M337 18V0" /></svg><img src="/assets/home/logo-gold-transparent.png" alt="ABCD Restaurant" /><div><h2>Ready to Experience</h2><p>An Authentic Taste of India?</p><a class="light-button" href="/reserve/">Book a Table →</a></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .hero { min-height: 1010px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 390px minmax(0,1fr); min-height: 900px; align-items: center; }
  .hero-copy { align-self: start; padding-top: 155px; position: relative; z-index: 2; }
  h1 { margin: 0; color: var(--maroon); font-family: var(--font-serif); font-size: 80px; font-weight: 600; line-height: 1.03; letter-spacing: -.045em; }
  h1 em { display: block; margin-top: 18px; color: var(--gold); font-weight: 500; line-height: 1.02; }
  .hero-copy > p { width: 335px; margin: 48px 0 35px; color: var(--muted); font-size: 15px; line-height: 1.65; }
  .pill-button { display: inline-flex; align-items: center; gap: 24px; min-height: 48px; padding: 6px 8px 6px 24px; border-radius: var(--radius-pill); background: var(--maroon); color: white; font-size: 12px; font-weight: 800; }
  .pill-button span { display: grid; place-items: center; width: 35px; height: 35px; border-radius: 50%; background: white; color: var(--maroon); font-size: 20px; }
  .hero-art { position: absolute; top: 175px; right: 0; width: min(820px,60vw); }
  .hero-art > img { width: 100%; }
  .promise-position { position: absolute; right: 85px; bottom: 65px; }
  .menu-explorer { min-height: 300px; padding: 44px 50px 34px; border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow-soft); }
  .menu-explorer h2, .why > h2 { display: flex; align-items: center; gap: 25px; margin: 0 0 47px; color: var(--gold); font-family: var(--font-serif); font-size: 18px; font-weight: 500; letter-spacing: 6px; text-align: center; text-transform: uppercase; }
  .menu-explorer h2::before,.menu-explorer h2::after,.why > h2::before,.why > h2::after { content:''; height:1px; flex:1; background:#ead8bf; }
  .category-grid { display: grid; grid-template-columns: repeat(7,1fr); }
  .category-grid a { display: grid; justify-items: center; gap: 10px; padding: 0 12px; border-right: 1px solid #ead8bf; color: var(--maroon); font-size: 11px; text-align: center; }
  .category-grid a:last-child { border: 0; } .category-grid img { width: 72px; height: 65px; object-fit: contain; }
  .text-link { display: block; margin-top: 31px; color: var(--maroon); font-size: 11px; font-weight: 800; text-align: center; }
  .signature { display: grid; grid-template-columns: 340px 1fr; gap: 45px; padding-top: 170px; }
  .eyebrow { color: var(--gold); font-family: var(--font-serif); font-size: 12px; letter-spacing: 3px; text-transform: uppercase; }
  .section-copy h2,.experience h2 { margin: 18px 0 20px; color: var(--maroon); font-family: var(--font-serif); font-size: 51px; line-height: .98; }
  .section-copy h2 em,.experience h2 em { display:block; color:var(--gold); font-weight:500; }
  .section-copy p,.experience p { color:var(--muted); font-size:13px; line-height:1.6; }.section-copy a { color:var(--maroon); font-size:11px; font-weight:800; }
  .dish-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }.dish-card { overflow:hidden; border:1px solid #ead1aa; border-radius:8px; background:var(--surface); box-shadow:var(--shadow-card); }.dish-image { position:relative; }.dish-image img { width:100%; aspect-ratio:1.38; object-fit:cover; }.dish-image span { position:absolute; top:8px; right:8px; padding:5px 10px; border-radius:20px; background:#fff4d8; color:#a36d26; font-size:9px; font-weight:800; text-transform:uppercase; }.dish-body { min-height:145px; padding:17px 16px 19px; }.dish-body h3 { margin:0; color:#4a2428; font-family:var(--font-serif); font-size:16px; }.dish-body p { min-height:46px; color:var(--muted); font-size:10px; line-height:1.45; }.dish-body strong { color:var(--maroon); font-size:12px; }
  .experience { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:80px; padding-top:165px; }.ambience { width:100%; border-radius:14px; box-shadow:var(--shadow-soft); }.experience h2 { font-size:50px; }.gallery-row { display:grid; grid-template-columns:repeat(4,1fr); gap:25px; padding-top:95px; }.gallery-row figure { margin:0; padding:12px 12px 25px; background:white; transform:rotate(-1deg); box-shadow:0 8px 18px rgb(65 40 25 / 5%); }.gallery-row figure:nth-child(even){transform:rotate(1deg)}.gallery-row img { width:100%; aspect-ratio:1; object-fit:cover; }.gallery-row figcaption { margin-top:12px; color:var(--muted); font-family:var(--font-serif); font-size:12px; font-style:italic; text-align:center; }
  .delivery { margin-top:140px; padding:90px 0 95px; background:var(--canvas-alt); }.delivery-frame { position:relative; padding:55px 55px 0; border:1px solid #d4a66e; border-bottom:0; border-radius:10px 10px 0 0; }.delivery h2 { width:max-content; margin:-72px auto 0; padding:0 30px; background:var(--canvas-alt); color:var(--maroon); font-family:var(--font-serif); font-size:38px; }.delivery p { margin:5px 0 42px; color:var(--gold); font-size:10px; letter-spacing:2px; text-align:center; text-transform:uppercase; }.partner-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:28px; }.partner-grid a { display:grid; place-items:center; overflow:hidden; min-height:125px; border:1px solid #dcbb89; border-radius:10px; background:var(--surface); color:var(--maroon); }.partner-grid strong { font-size:22px; }.partner-grid span { align-self:end; width:100%; padding:13px; border-radius:30px 30px 0 0; background:var(--maroon); color:white; font-size:10px; text-align:center; }
  .why { position:relative; padding-top:120px; padding-bottom:35px; }.why::before { content:'❧'; position:absolute; left:-55px; top:105px; color:#b98a45; font-family:var(--font-serif); font-size:150px; opacity:.35; transform:rotate(-28deg); }.why > h2 { margin-inline:auto; max-width:700px; font-size:17px; }.why-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:40px; text-align:center; }.why-grid img { width:82px; height:82px; object-fit:contain; margin:auto; }.why-grid h3 { color:var(--maroon); font-family:var(--font-serif); font-size:15px; }.why-grid p { color:var(--muted); font-size:10px; }
  .final-cta { position:relative; display:grid; grid-template-columns:220px 1fr; align-items:center; min-height:315px; margin-top:110px; padding:45px 70px; overflow:hidden; border-radius:8px; background:var(--maroon); color:white; }.final-cta::before { content:''; position:absolute; top:34px; right:34px; width:150px; height:105px; border:1px solid rgb(185 138 69 / 45%); border-radius:80px 80px 0 0; }.final-cta::after { content:'❧'; position:absolute; right:260px; top:5px; color:var(--gold); font-size:150px; opacity:.35; transform:rotate(38deg); }.final-cta img { width:170px; }.final-cta > div { position:relative; z-index:2; text-align:center; }.final-cta h2 { margin:0; font-family:var(--font-serif); font-size:40px; font-weight:500; }.final-cta p { margin:8px 0 20px; color:#d1ad5f; font-family:var(--font-serif); font-size:28px; font-style:italic; }.light-button { display:inline-block; padding:11px 20px; border-radius:var(--radius-pill); background:white; color:var(--maroon); font-size:11px; font-weight:800; }
  .why::before,.final-cta::before,.final-cta::after { content:none; }
  .why-leaf { position:absolute; left:-65px; top:105px; width:145px; height:185px; fill:none; stroke:#9d7b52; stroke-width:1; opacity:.5; }
  .cta-lines { position:absolute; inset:0; width:100%; height:100%; fill:none; stroke:#b98a45; stroke-width:1; opacity:.55; }
  .final-cta > img { position:relative; z-index:2; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns:1fr; }.hero-art { position:relative; top:auto; right:auto; width:100%; }.promise-position { right:20px; bottom:20px; }.category-grid { grid-template-columns:repeat(4,1fr); gap:25px 0; }.signature,.experience { grid-template-columns:1fr; }.gallery-row,.why-grid { grid-template-columns:repeat(2,1fr); } }
  @media (max-width: 700px) { .hero{min-height:auto}.hero-grid{min-height:auto}.hero-copy{padding-top:65px}.hero-copy h1{font-size:54px}.hero-copy>p{width:auto}.hero-art{margin-top:45px}.promise-position{right:5px;bottom:10px}.menu-explorer{min-height:auto;padding:32px 18px}.menu-explorer h2,.why>h2{gap:10px;font-size:14px;letter-spacing:3px}.category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.signature{gap:32px;padding-top:85px}.dish-grid{grid-template-columns:minmax(0,1fr)}.experience{gap:35px;padding-top:85px}.gallery-row{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding-top:55px}.delivery{margin-top:75px;padding:70px 0}.delivery-frame{padding:45px 15px 0}.delivery h2{width:auto;padding:0 10px;font-size:28px}.partner-grid{grid-template-columns:minmax(0,1fr)}.why-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.final-cta{grid-template-columns:1fr;margin-top:65px;padding:42px 22px}.final-cta>img{width:125px;margin:0 auto 25px}.final-cta h2{font-size:30px}.final-cta p{font-size:21px}.why-leaf{display:none}}
</style>
