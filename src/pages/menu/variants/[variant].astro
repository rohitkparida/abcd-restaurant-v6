---
import BaseLayout from '../../../layouts/BaseLayout.astro';import SiteHeader from '../../../components/SiteHeader.astro';import type { MenuVariant } from '../../../types/domain';
export function getStaticPaths(){return ['1','2','3','4','5'].map(variant=>({params:{variant}}))}
const variant=Astro.params.variant as MenuVariant;
const labels=['Appetizers','Biryani & Bread','Curries','Indo-Chinese','Dragon & Spice','Desserts','Drinks'];
---
<BaseLayout title={`Menu Flag Variant ${variant} — ABCD Restaurant`} noIndex><SiteHeader active="/menu/"/><main class={`variant variant-${variant}`}><section class="container variant-hero"><div><span>Menu navigation study</span><h1>Our Menu</h1><p>Explore the flavours of ABCD through a distinctive category navigation treatment.</p></div><img src="/assets/menu-hero-clean.png" alt="Indian dishes" /></section><nav class="flags container" aria-label="Menu categories">{labels.map((label,index)=><a href="/menu/"><i>{String.fromCharCode(65+Math.min(index,3))}</i><span>{label}</span></a>)}</nav></main></BaseLayout>
<style>.variant{min-height:100vh}.variant-hero{display:grid;grid-template-columns:400px 1fr;align-items:center;min-height:560px;overflow:hidden}.variant-hero>div{position:relative;z-index:2}.variant-hero>div>span{color:var(--gold);font-size:11px;letter-spacing:5px;text-transform:uppercase}.variant-hero h1{margin:16px 0;color:var(--maroon);font-family:var(--font-serif);font-size:76px}.variant-hero p{color:var(--muted);font-size:17px;line-height:1.5}.variant-hero img{width:760px;max-width:none}.flags{display:flex;justify-content:center;gap:15px;padding:28px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}.flags a{display:flex;align-items:center;gap:9px;color:var(--maroon);font-size:11px;font-weight:800}.flags i{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--line);border-radius:50%;font-family:var(--font-serif);font-size:19px;font-style:normal}.variant-2 .flags a{padding:8px 16px;border:1px solid var(--line);border-radius:30px}.variant-2 .flags i{width:auto;height:auto;border:0}.variant-3 .flags{justify-content:space-between}.variant-3 .flags a{flex-direction:column}.variant-4 .flags{position:absolute;top:180px;left:80px;width:220px;flex-direction:column}.variant-4 .variant-hero>div{margin-left:260px}.variant-4 .flags a{padding:8px;border-bottom:1px solid #ead8bf}.variant-5 .flags a{flex:1;justify-content:center;padding:16px;border-radius:8px;background:#f6ead8}.variant-5 .flags i{border:0;background:var(--maroon);color:white}</style>
<style>@media(max-width:700px){.variant-hero{grid-template-columns:minmax(0,1fr);min-height:auto;padding-block:45px}.variant-hero h1{font-size:48px}.variant-hero img{width:100%;max-width:100%;margin-top:25px}.flags,.variant-3 .flags,.variant-5 .flags{justify-content:flex-start;overflow-x:auto;padding:18px}.flags a,.variant-5 .flags a{flex:0 0 auto}.variant-4 .flags{position:static;width:auto;flex-direction:row}.variant-4 .variant-hero>div{margin-left:0}}</style>
