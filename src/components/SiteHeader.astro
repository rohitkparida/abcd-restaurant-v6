---
import type { PublicRoute } from '../types/domain';
interface Props { active?: PublicRoute }
const { active } = Astro.props;
const links: Array<{ href: PublicRoute; label: string }> = [
  { href: '/', label: 'Home' }, { href: '/menu/', label: 'Menu' },
  { href: '/our-story/', label: 'Our Story' }, { href: '/gallery/', label: 'Gallery' },
  { href: '/reserve/', label: 'Reserve' }, { href: '/contact/', label: 'Contact' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="ABCD Restaurant home"><img src="/assets/logo.png" alt="ABCD Restaurant" /></a>
    <nav aria-label="Primary navigation">
      {links.map(({ href, label }) => <a href={href} aria-current={active === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <a class="book" href="/reserve/">Book a Table <span aria-hidden="true">→</span></a>
  </div>
</header>
<style>
  .site-header { position: relative; z-index: 20; padding: 38px 0 26px; }
  .header-inner { display: grid; grid-template-columns: 200px 1fr 200px; align-items: center; }
  .brand { width: 170px; }
  .brand img { width: 100%; height: auto; }
  nav { display: flex; justify-content: center; gap: 41px; font-size: 15px; font-weight: 700; color: #201416; }
  nav a { position: relative; padding: 9px 0; }
  nav a[aria-current='page'] { color: var(--maroon); }
  nav a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: currentColor; }
  .book { justify-self: end; display: inline-flex; align-items: center; gap: 13px; min-height: 52px; padding: 5px 7px 5px 24px; border-radius: var(--radius-pill); background: var(--maroon); color: white; font-size: 13px; font-weight: 800; }
  .book span { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid rgb(255 255 255 / 45%); border-radius: 50%; font-size: 21px; }
  @media (max-width: 900px) { .header-inner { grid-template-columns: 1fr auto; } nav { display: none; } .brand { width: 105px; } }
</style>
