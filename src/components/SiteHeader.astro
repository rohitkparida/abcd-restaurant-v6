---
import type { PublicRoute } from '../types/domain';
interface Props { active?: PublicRoute }
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
const route = (href: string) => href === '/' ? base : `${base}${href.replace(/^\//, '')}`;
const links: Array<{ href: PublicRoute; label: string }> = [
  { href: '/', label: 'Home' }, { href: '/menu/', label: 'Menu' },
  { href: '/our-story/', label: 'Our Story' }, { href: '/gallery/', label: 'Gallery' },
  { href: '/reserve/', label: 'Reserve' }, { href: '/contact/', label: 'Contact' },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={route('/')} aria-label="ABCD Restaurant home"><img src={`${base}assets/logo-footer.png`} alt="ABCD Restaurant" /></a>
    <nav aria-label="Primary navigation">
      {links.map(({ href, label }) => <a href={route(href)} aria-current={active === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <a class="book" href={route('/reserve/')}>Book a Table <span aria-hidden="true">→</span></a>
    <details class="mobile-menu">
      <summary aria-label="Open navigation"><i></i><i></i><i></i></summary>
      <nav aria-label="Mobile navigation">
        {links.map(({ href, label }) => <a href={route(href)} aria-current={active === href ? 'page' : undefined}>{label}</a>)}
      </nav>
    </details>
  </div>
</header>
<style>
  .site-header { position: relative; z-index: 20; padding: 29px 0 26px; }
  .header-inner { display: grid; grid-template-columns: 200px 1fr 200px; align-items: center; }
  .brand { width: 177px; }
  .brand img { width: 100%; height: auto; }
  nav { display: flex; justify-content: center; gap: 38px; font-size: 16px; font-weight: 700; color: #201416; }
  nav a { position: relative; padding: 9px 0; }
  nav a[aria-current='page'] { color: var(--maroon); }
  nav a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: currentColor; }
  .book { justify-self: end; display: inline-flex; align-items: center; gap: 13px; min-height: 52px; padding: 5px 7px 5px 24px; border-radius: var(--radius-pill); background: var(--maroon); color: white; font-size: 13px; font-weight: 800; }
  .book span { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid rgb(255 255 255 / 45%); border-radius: 50%; font-size: 21px; }
  .mobile-menu { display: none; }
  @media (min-width: 901px) {
    .brand { width: 190px; }
    nav { gap: 32px; }
  }
  @media (max-width: 900px) {
    .site-header { padding: 18px 0; }
    .header-inner { position: relative; grid-template-columns: 1fr auto auto; gap: 10px; }
    .header-inner > nav { display: none; }
    .brand { width: 105px; }
    .book { min-height: 42px; padding: 4px 5px 4px 15px; font-size: 11px; }
    .book span { width: 30px; height: 30px; }
    .mobile-menu { display: block; }
    .mobile-menu summary { display: grid; place-content: center; gap: 4px; width: 42px; height: 42px; border: 1px solid var(--line); border-radius: 50%; cursor: pointer; list-style: none; }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu summary i { width: 17px; height: 1.5px; background: var(--maroon); }
    .mobile-menu nav { position: absolute; z-index: 30; top: calc(100% + 12px); right: 0; left: 0; display: grid; gap: 2px; padding: 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); box-shadow: var(--shadow-card); }
    .mobile-menu nav a { padding: 12px 14px; border-radius: 8px; }
    .mobile-menu nav a[aria-current='page'] { background: var(--canvas-alt); }
  }
  @media (max-width: 430px) {
    .book { padding-left: 12px; }
    .book span { display: none; }
  }
</style>
