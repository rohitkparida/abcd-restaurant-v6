---
import type { MenuItem } from '../types/domain';
import { assetPath } from '../lib/site';
interface Props { item:MenuItem }
const { item } = Astro.props;
const image = assetPath(item.image.replace(/^\/assets\//, ''));
---
<article class="menu-card" data-menu-item={item.id}>
  <img src={image} alt={item.name} loading="lazy" />
  <div class="copy"><h3>{item.name}{item.vegetarian && <i class="veg" title="Vegetarian"></i>}{item.spicy && <i class="spicy" title="Spicy"></i>}</h3><p>{item.description}</p><strong>{item.price}</strong></div>
  <button type="button" data-add-item={item.id}>+ Add</button>
  {item.featured && <span class="featured">Chef’s Pick</span>}
</article>
<style>
  .menu-card { position:relative; display:grid; grid-template-columns:112px minmax(0,1fr) auto; align-items:center; gap:12px; min-height:126px; padding:12px 12px 12px 10px; border-radius:14px; background:#fffaf3; box-shadow:0 8px 22px rgb(84 52 30 / 7%); }
  img { width:112px; height:100px; border-radius:10px; object-fit:cover; }
  h3 { margin:0; color:#4a2428; font-family:var(--font-serif); font-size:17px; line-height:1.1; }
  p { margin:8px 0; color:var(--muted); font-size:10px; line-height:1.45; }
  strong { color:var(--gold); font-family:var(--font-serif); font-size:18px; font-style:italic; }
  button { align-self:end; min-width:76px; height:32px; border:0; border-radius:6px; background:var(--maroon); color:white; font-size:11px; font-weight:800; cursor:pointer; }
  i { display:inline-block; width:8px; height:8px; margin-left:5px; border-radius:50%; }.veg{background:#1aab65}.spicy{background:#dc3648}
  .featured { position:absolute; top:-8px; left:-8px; padding:7px 9px; background:var(--maroon); color:white; font-size:8px; font-weight:800; letter-spacing:.5px; text-transform:uppercase; }
  @media(max-width:1100px){.menu-card{grid-template-columns:90px minmax(0,1fr)}img{width:90px;height:82px}button{grid-column:2;justify-self:end}}
</style>
